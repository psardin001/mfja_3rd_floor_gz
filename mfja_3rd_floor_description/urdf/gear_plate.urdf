    </visual>
    <visual>
      <origin xyz="0 0 0.0105"/>
      <geometry>
        <box size=".28 .18 0.021"/>
      </geometry>
    </visual>
    <!-- collision model -->
    <collision>
      <origin xyz="0 0.095 0.015"/>
      <geometry>
        <box size=".3 .01 0.03"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.095 0.015"/>
