      <origin xyz="0 0.095 0.015"/>
      <geometry>
        <box size=".3 .01 0.03"/>
      </geometry>
    </visual>
    <visual>
      <origin xyz="0 -0.095 0.015"/>
      <geometry>
        <box size=".3 .01 0.03"/>
      </geometry>
    </visual>
    <visual>
      <origin xyz="0.145 0 0.015"/>
      <geometry>
        <box size=".01 .18 0.03"/>
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.145 0 0.015"/>
